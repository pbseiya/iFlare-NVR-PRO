# Ignore Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/
.venv

# Ignore uv files
.uv/
uv.lock

# Ignore Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
.vercel

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Ignore C++ build files
*.o
*.a
*.so
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Ignore Rust build files
target/
Cargo.lock
**/*.rs.bk

# Ignore model files (too large)
models/*.pt
models/*.onnx
models/*.xml
models/*.bin
!models/.gitkeep

# Ignore video files
videos/*.mp4
videos/*.avi
videos/*.mov
videos/*.mkv
videos/output/*
!videos/.gitkeep
!videos/output/.gitkeep

# Ignore database dumps
*.sql.gz
*.dump

# Ignore logs
*.log
logs/

# Ignore temporary files
tmp/
temp/
*.tmp

# Ignore Docker volumes
postgres_data/
pgadmin_data/

# Ignore test coverage
.coverage
htmlcov/
.pytest_cache/

# Ignore compiled files
*.pyc
*.pyo
*.pyd

# Keep empty directories
!.gitkeep

# Customer Data & Media
*.jpg
*.jpeg
*.png
*.gif
*.webp
!nvr_wireframe_sketch.png

# Additional Video Formats
*.webm

# Database Files
*.sqlite
*.sqlite3
*.db
database/*.db
rtsp_webhook.txt
